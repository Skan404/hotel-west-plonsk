---
import Layout from '../layouts/Layout.astro';
import {site} from '../data/site';
const rooms=[
 {capacity:'1 osoba',label:'Pokój jednoosobowy',price:'150'},
 {capacity:'2 osoby',label:'Pokój dwuosobowy',price:'200'},
 {capacity:'3 osoby',label:'Pokój trzyosobowy',price:'250'},
 {capacity:'4 osoby',label:'Pokój czteroosobowy',price:'300'},
 {capacity:'5 osób',label:'Pokój pięcioosobowy',price:'400'},
];
---
<Layout title="Cennik pokoi i wynajmu" description="Cennik West Hotel Płońsk: pokoje jednoosobowe 150 zł, dwuosobowe 200 zł, trzyosobowe 250 zł, czteroosobowe 300 zł i pięcioosobowe 400 zł. Mieszkania i kawalerki na wynajem.">
<section class="pricing-page">
  <header class="pricing-intro" data-reveal="reveal">
    <span class="eyebrow">WEST HOTEL · PŁOŃSK · CENNIK</span>
    <h1>Cena pobytu.<br/><em>Jasne zasady.</em></h1>
    <p>Wybierz pokój odpowiedni do liczby gości. Szukasz mieszkania lub planujesz dłuższy pobyt? Zadzwoń — ustalimy szczegóły.</p>
  </header>

  <section class="pricing-rooms" aria-labelledby="rooms-title">
    <div class="pricing-section-heading" data-reveal="right"><div><span class="eyebrow">NOCLEGI</span><h2 id="rooms-title">Pokoje</h2></div><p>Kwoty w złotych</p></div>
    <div class="room-price-grid">
      {rooms.map((room,index)=><article class="room-price-card" data-reveal={index%2===0?'left':'right'} data-reveal-order={index%4}>
        <span class="room-price-index">{String(index+1).padStart(2,'0')}</span>
        <span class="room-price-capacity">{room.capacity}</span>
        <h3>{room.label}</h3>
        <p class="room-price-amount"><strong>{room.price}</strong><span>zł</span></p>
      </article>)}
      <article class="room-price-card room-price-card-contact" data-reveal="pop" data-reveal-order="2">
        <span class="room-price-index">06</span>
        <span class="room-price-capacity">MIESZKANIA · KAWALERKI</span>
        <h3>Więcej osób lub osobna przestrzeń?</h3>
        <p>Skontaktuj się z nami — przedstawimy możliwości i ustalimy szczegóły.</p>
        <a href={`tel:${site.phone.replace(/\s/g,'')}`}>Prosimy o kontakt <span aria-hidden="true">↗</span></a>
      </article>
    </div>
  </section>

  <section class="pricing-rental">
    <div data-reveal="left"><span class="eyebrow">WIĘCEJ MOŻLIWOŚCI</span><h2>Mieszkania<br/><em>i kawalerki.</em></h2></div>
    <div class="pricing-rental-copy" data-reveal="right"><p>Oferujemy również mieszkania, pokoje i kawalerki na wynajem. Przy pobycie powyżej 3 dób istnieje możliwość indywidualnego ustalenia ceny.</p><a class="button" href={`tel:${site.phone.replace(/\s/g,'')}`}>Zapytaj o ofertę <span>↗</span></a></div>
  </section>

  <section class="pricing-contact"><div data-reveal="reveal"><span class="eyebrow">ZAREZERWUJ LUB ZAPYTAJ</span><h2>Porozmawiajmy<br/><em>o Twoim pobycie.</em></h2></div><a href={`tel:${site.phone.replace(/\s/g,'')}`} class="pricing-phone" data-reveal="pop">{site.phone}<span aria-hidden="true">↗</span></a></section>
</section>
</Layout>
