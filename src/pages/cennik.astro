---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<MainLayout title="Cennik">
    <Navbar />
    
    <main class="pt-20">
        <header class="py-16 md:py-20 bg-white border-b border-slate-100 text-center">
            <div class="max-w-7xl mx-auto px-4">
                <h1 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6">Cennik i Oferta</h1>
                <p class="text-xl text-slate-600 max-w-2xl mx-auto">
                    Poznaj nasze konkurencyjne ceny. Brak ukrytych opłat.
                </p>
            </div>
        </header>

        <section class="py-20 bg-background-light">
            <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-slate-200">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-50 border-b-2 border-primary/30">
                                    <th class="py-6 px-6 text-slate-900 font-bold text-lg">Rodzaj Zakwaterowania</th>
                                    <th class="py-6 px-6 text-slate-900 font-bold text-lg text-center">Cena za dobę</th>
                                    <th class="py-6 px-6 text-transparent w-1/6">Akcja</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <tr class="hover:bg-slate-50 transition-colors">
                                    <td class="py-6 px-6">
                                        <div class="font-bold text-slate-800 text-lg">Pokój 1-osobowy</div>
                                    </td>
                                    <td class="py-6 px-6 text-center">
                                        <span class="text-primary font-bold text-xl">120 PLN</span>
                                    </td>
                                    <td class="py-6 px-6 text-center">
                                        <a class="inline-block px-4 py-2 border border-primary text-primary hover:bg-primary hover:text-white rounded-lg font-medium transition-colors text-sm" href="/kontakt">Rezerwuj</a>
                                    </td>
                                </tr>
                                <tr class="bg-slate-50/50 hover:bg-slate-50 transition-colors">
                                    <td class="py-6 px-6">
                                        <div class="font-bold text-slate-800 text-lg">Pokój 2-osobowy</div>
                                    </td>
                                    <td class="py-6 px-6 text-center">
                                        <span class="text-primary font-bold text-xl">160 PLN</span>
                                    </td>
                                    <td class="py-6 px-6 text-center">
                                        <a class="inline-block px-4 py-2 border border-primary text-primary hover:bg-primary hover:text-white rounded-lg font-medium transition-colors text-sm" href="/kontakt">Rezerwuj</a>
                                    </td>
                                </tr>
                                 <tr class="hover:bg-slate-50 transition-colors">
                                    <td class="py-6 px-6">
                                        <div class="font-bold text-slate-800 text-lg">Pokój 3-osobowy</div>
                                    </td>
                                    <td class="py-6 px-6 text-center">
                                        <span class="text-primary font-bold text-xl">210 PLN</span>
                                    </td>
                                    <td class="py-6 px-6 text-center">
                                        <a class="inline-block px-4 py-2 border border-primary text-primary hover:bg-primary hover:text-white rounded-lg font-medium transition-colors text-sm" href="/kontakt">Rezerwuj</a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</MainLayout>