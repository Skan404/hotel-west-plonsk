---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import {site} from '../data/site';
---
<Layout title="Noclegi w centrum Płońska" description="West Hotel przy ul. Wolności 6 w centrum Płońska. Pokoje, mieszkania i kawalerki na wynajem. Duży, ogrodzony i monitorowany parking. Zadzwoń: +48 533 222 444.">
<section class="hero hero-video"><div class="hero-copy"><span class="eyebrow"><span></span> WEST HOTEL · PŁOŃSK</span><h1>Nocleg<br/><em>na miejscu.</em></h1><p class="hero-summary">Pokoje, mieszkania i kawalerki na wynajem przy ul. <strong class="address-accent">Wolności 6</strong>. Dla gości prywatnych i firm.</p><div class="hero-actions"><a class="button" href={`tel:${site.phone.replace(/\s/g,'')}`}>Zadzwoń: {site.phone} <span aria-hidden="true">↗</span></a><a class="text-link" href="/cennik/">Zobacz cennik</a></div><div class="hero-address"><span>NASZ ADRES</span><strong>ul. <b class="address-accent">Wolności 6</b>, Płońsk</strong><a href={site.maps} target="_blank" rel="noopener noreferrer">Wyznacz trasę ↗</a></div></div><div class="hero-image hero-image-compact"><video class="hero-drone" autoplay muted loop playsinline preload="auto" poster="/images/aerial-1280.webp" aria-label="Zapętlony film z drona przedstawiający West Hotel i okolicę"><source src="/video/west-hotel.mp4" type="video/mp4"/><source src="/video/west-hotel.webm" type="video/webm"/></video><div class="image-caption"><span>WEST HOTEL</span><span>Widok z drona</span></div></div></section>
<section class="quick-offer" id="pobyt"><div class="quick-offer-title" data-reveal="right"><span class="eyebrow">NOCLEGI I WYNAJEM</span><h2>Wybierz przestrzeń<br/><em>dla siebie.</em></h2><p>Przy pobycie powyżej 3 dób możemy ustalić cenę indywidualnie.</p></div><div class="offer-types" data-reveal="left"><a href="/cennik/"><span>01</span><strong>Pokoje 1–5-osobowe</strong><b>od 150 zł ↗</b></a><a href="/galeria/#kuchnie"><span>02</span><strong>Mieszkania i kawalerki</strong><b>Sprawdź ↗</b></a><a href="/kontakt/"><span>03</span><strong>Oferta dla firm</strong><b>Kontakt ↗</b></a></div></section>
<section class="home-stay-detail"><div class="home-stay-photo" data-reveal="left"><Photo id="room-1" alt="Pokój gościnny w West Hotel Płońsk" sizes="(max-width: 700px) 100vw, 50vw"/><span>POKOJE · MIESZKANIA · KAWALERKI</span></div><div class="home-stay-copy" data-reveal="right"><span class="eyebrow">POBYT DOPASOWANY DO CIEBIE</span><h2>Odpocznij<br/><em>po swojemu.</em></h2><p>W West Hotel znajdziesz pokoje dla jednej lub kilku osób, a także mieszkania i kawalerki na wynajem. To wygodna baza podczas wyjazdu służbowego, pracy w okolicy lub pobytu w Płońsku.</p><p>Planujesz zostać dłużej? Przy pobycie przekraczającym 3 doby możesz skontaktować się z nami i ustalić cenę indywidualnie.</p><div class="home-stay-links"><a class="button" href="/cennik/">Poznaj ceny <span>↗</span></a><a class="text-link" href={`tel:${site.phone.replace(/\s/g,'')}`}>Zadzwoń: {site.phone}</a></div></div></section>
<section class="home-feature-row"><div class="home-feature-copy" data-reveal="right"><span class="eyebrow">WYGODNY PRZYJAZD</span><h2>Przyjeżdżasz<br/><em>własnym autem?</em></h2><p>Do dyspozycji gości jest duży, ogrodzony i monitorowany parking. To praktyczne rozwiązanie zarówno podczas krótkiego noclegu, jak i dłuższego pobytu w Płońsku.</p><a class="text-link" href="/kontakt/">Zapytaj o pobyt ↗</a></div><div class="home-feature-photo" data-reveal="left"><Photo id="courtyard" alt="Budynek West Hotel od strony dziedzińca" sizes="(max-width: 700px) 100vw, 50vw"/></div></section>
<section class="home-feature-row home-feature-row-reverse"><div class="home-feature-copy" data-reveal="left"><span class="eyebrow">DOBRY PUNKT W PŁOŃSKU</span><h2>W centrum.<br/><em>Przy Wolności 6.</em></h2><p>West Hotel znajduje się w centrum Płońska. Na mapie zaznaczyliśmy lokalizację obiektu, żeby łatwiej było zaplanować dojazd i odnaleźć nas po przyjeździe.</p><p>Przed podróżą zadzwoń — podpowiemy w sprawie dostępności pokoi, mieszkań i kawalerek.</p><a class="button" href={site.maps} target="_blank" rel="noopener noreferrer">Wyznacz trasę <span>↗</span></a></div><figure class="home-map" data-reveal="reveal"><a href={site.maps} target="_blank" rel="noopener noreferrer" aria-label="Otwórz mapę i wyznacz trasę do West Hotel"><img src="/images/location-map.png" alt="Mapa centrum Płońska z pinezką wskazującą West Hotel przy ul. Wolności 6" loading="lazy" decoding="async"/></a><figcaption>West Hotel · ul. Wolności 6 · Płońsk</figcaption></figure></section>
<section class="home-business"><div data-reveal="right"><span class="eyebrow">DLA GOŚCI PRYWATNYCH I FIRM</span><h2>Nocleg w Płońsku<br/><em>na Twoich warunkach.</em></h2></div><p data-reveal="left">Przyjmujemy zapytania o noclegi indywidualne i pobyty związane z pracą. Wybierz pokój według liczby osób albo zapytaj o mieszkanie czy kawalerkę. Przy pobycie dłuższym niż 3 doby możemy indywidualnie ustalić cenę.</p><a class="button" href={`tel:${site.phone.replace(/\s/g,'')}`} data-reveal="pop">Porozmawiajmy: {site.phone} <span>↗</span></a></section>
<section class="home-gallery"><div data-reveal="reveal"><span class="eyebrow">ZOBACZ NASZE WNĘTRZA</span><h2>Przyjrzyj się<br/><em>z bliska.</em></h2></div><div class="home-gallery-photos"><a href="/galeria/#pokoje" data-reveal="left"><Photo id="room-2" alt="Wnętrze pokoju w West Hotel"/><span>Pokoje ↗</span></a><a href="/galeria/#kuchnie" data-reveal="pop"><Photo id="apartment-kitchen" alt="Kuchnia w apartamencie"/><span>Kuchnie i mieszkania ↗</span></a><a href="/galeria/#obiekt" data-reveal="right"><Photo id="front-night" alt="Front hotelu po zmroku"/><span>Nasz obiekt ↗</span></a></div><a class="text-link" href="/galeria/" data-reveal="lift">Zobacz całą galerię ↗</a></section>
</Layout>
